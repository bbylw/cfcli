---
import { GithubLogoIcon, ArrowUpRightIcon } from "@phosphor-icons/react";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

const columns = [
  {
    title: "文档",
    links: [
      { href: "/docs/install", label: "安装与登录" },
      { href: "/docs/quickstart", label: "部署第一个 Worker" },
      { href: "/docs/agents", label: "面向编码智能体" },
      { href: "/docs/migrate", label: "从 Wrangler 迁移" },
    ],
  },
  {
    title: "参考",
    links: [
      { href: "/docs/commands", label: "命令参考" },
      { href: "/docs/config", label: "cloudflare.config.ts" },
      { href: "/docs/bindings", label: "绑定 helper" },
      { href: "/docs/triggers", label: "触发器" },
    ],
  },
  {
    title: "更多",
    links: [
      { href: "/blog", label: "博客" },
      {
        href: "https://developers.cloudflare.com/",
        label: "Cloudflare 开发者文档",
        external: true,
      },
      {
        href: "https://github.com/cloudflare/cf",
        label: "GitHub 仓库",
        external: true,
      },
    ],
  },
];
---

<footer class="mt-16 border-t border-line">
  <div class="shell grid gap-12 py-14 md:grid-cols-[1.2fr_2fr]">
    <div class="max-w-sm">
      <div class="flex items-center gap-2.5">
        <Logo />
        <span class="font-mono text-sm text-fog-100">cf.cli</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-fog-500">
        面向整个 Cloudflare API 的智能体命令行工具。公开测试中，命令、配置与构建输出在稳定版发布前仍可能变化。
      </p>
      <button
        type="button"
        id="footer-copy"
        class="mt-5 flex w-full items-center gap-2 rounded-full border border-line bg-ink-900 px-3.5 py-2 font-mono text-[13px] text-fog-300 transition-colors duration-200 hover:border-ink-600"
        aria-label="复制安装命令 npm i -g cf"
      >
        <span class="select-none text-fog-600">$</span>
        <span>npm i -g cf</span>
        <span id="footer-copy-hint" class="ml-auto text-[11px] text-fog-600">复制</span>
      </button>
      <p class="sr-only" role="status" id="footer-copy-status"></p>
    </div>

    <div class="grid gap-10 sm:grid-cols-3">
      {
        columns.map((column) => (
          <div>
            <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-fog-600">
              {column.title}
            </h2>
            <ul class="mt-4 grid gap-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex items-center gap-1 text-sm text-fog-500 transition-colors duration-200 hover:text-fog-100"
                  >
                    {link.label}
                    {link.external && <ArrowUpRightIcon size={12} weight="bold" aria-hidden />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="rule">
    <div
      class="shell flex flex-wrap items-center justify-between gap-4 py-5 text-xs text-fog-600"
    >
      <p>本站为 cf 中文社区站点，内容整理自 Cloudflare 官方 README、博客与开发者文档。</p>
      <div class="flex items-center gap-5">
        <span class="font-mono">© {year} · 非官方中文站点</span>
        <a
          href="https://github.com/cloudflare/cf"
          class="flex items-center gap-1.5 text-fog-500 transition-colors hover:text-fog-100"
        >
          <GithubLogoIcon size={14} weight="bold" aria-hidden />
          cloudflare/cf
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const copyButton = document.getElementById("footer-copy");
  const hint = document.getElementById("footer-copy-hint");
  const status = document.getElementById("footer-copy-status");

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText("npm i -g cf");
      if (hint) hint.textContent = "已复制";
      if (status) status.textContent = "安装命令已复制到剪贴板";
      window.setTimeout(() => {
        if (hint) hint.textContent = "复制";
      }, 1800);
    } catch {
      if (status) status.textContent = "复制失败，请手动选择命令文本";
    }
  });
</script>
