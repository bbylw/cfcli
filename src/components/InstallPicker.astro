---
import { CopyIcon } from "@phosphor-icons/react";

const managers = [
  { id: "npm", label: "npm", command: "npm i -g cf" },
  { id: "bun", label: "bun", command: "bun add --global cf" },
  { id: "pnpm", label: "pnpm", command: "pnpm add --global cf" },
  { id: "yarn", label: "yarn", command: "yarn global add cf" },
];
---

<div class="min-w-0 overflow-hidden rounded-[16px] border border-line bg-ink-900">
  <div
    class="flex gap-1 overflow-x-auto border-b border-line px-2 py-2"
    role="radiogroup"
    aria-label="包管理器"
  >
    {
      managers.map((manager, index) => (
        <label class="shrink-0 cursor-pointer">
          <input
            type="radio"
            name="pm"
            id={`pm-${manager.id}`}
            value={manager.command}
            checked={index === 0}
            class="peer sr-only"
            data-pm-input
          />
          <span
            class="block rounded-full px-3.5 py-1.5 font-mono text-[12px] text-fog-600 transition-colors duration-200 peer-checked:bg-ink-800 peer-checked:text-fog-100 hover:text-fog-300 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ember-500"
          >
            {manager.label}
          </span>
        </label>
      ))
    }
  </div>

  <div class="flex items-center justify-between gap-4 px-4 py-4">
    <code
      class="overflow-x-auto whitespace-nowrap font-mono text-[13.5px] text-fog-100"
    >
      <span class="mr-2 select-none text-fog-600">$</span><span id="pm-command"
        >{managers[0].command}</span
      >
    </code>
    <button
      type="button"
      id="pm-copy"
      class="flex shrink-0 items-center gap-1.5 rounded-full border border-ink-600 px-3 py-1.5 font-mono text-[11px] text-fog-500 transition-colors hover:text-fog-600 hover:text-fog-100"
      aria-label="复制安装命令"
    >
      <CopyIcon size={13} weight="bold" />
      <span id="pm-copy-label">复制</span>
    </button>
  </div>
  <p class="sr-only" role="status" id="pm-status"></p>
</div>

<script>
  const inputs = Array.from(
    document.querySelectorAll<HTMLInputElement>("[data-pm-input]"),
  );
  const output = document.getElementById("pm-command");
  const copyButton = document.getElementById("pm-copy");
  const copyLabel = document.getElementById("pm-copy-label");
  const status = document.getElementById("pm-status");

  const sync = () => {
    const checked = inputs.find((input) => input.checked);
    if (checked && output) output.textContent = checked.value;
  };

  inputs.forEach((input) => {
    input.addEventListener("change", sync);
  });

  // 原生 radio 已自带方向键导航；补上 APG 要求的 Home / End
  inputs.forEach((input) => {
    input.addEventListener("keydown", (event) => {
      const last = event.key === "End" ? inputs.length - 1 : event.key === "Home" ? 0 : -1;
      if (last === -1) return;
      event.preventDefault();
      inputs[last]?.click();
      inputs[last]?.focus();
    });
  });

  copyButton?.addEventListener("click", async () => {
    const command = inputs.find((input) => input.checked)?.value;
    if (!command) return;
    try {
      await navigator.clipboard.writeText(command);
      if (copyLabel) copyLabel.textContent = "已复制";
      if (status) status.textContent = "安装命令已复制到剪贴板";
      window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = "复制";
      }, 1800);
    } catch {
      if (status) status.textContent = "复制失败，请手动选择命令文本";
    }
  });
</script>
