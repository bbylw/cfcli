---
/**
 * cf 品牌标识：橙渐变 tile + 纯几何笔画 "cf"。
 * 与 public/favicon.svg 是同一设计，站内用内联 SVG 以便跟随主题，
 * favicon 用文件版（无字体依赖，处处一致）。
 */
import { nextId } from "../scripts/uid";

interface Props {
  class?: string;
}

const { class: className = "h-8 w-8" } = Astro.props;

// 同一页面渲染多次时，渐变 id 必须唯一，否则 url(#…) 会撞车
const gid = nextId("cf-tile");
---

<span
  class:list={["grid shrink-0 place-items-center", className]}
  aria-hidden="true"
>
  <svg viewBox="0 0 64 64" class="h-full w-full" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffa04d" />
        <stop offset="0.55" stop-color="#f6821f" />
        <stop offset="1" stop-color="#d96a10" />
      </linearGradient>
    </defs>
    <rect x="2" y="2" width="60" height="60" rx="15" fill={`url(#${gid})`} />
    <rect
      x="3.2"
      y="3.2"
      width="57.6"
      height="57.6"
      rx="13.8"
      fill="none"
      stroke="#ffffff"
      stroke-opacity="0.2"
      stroke-width="1.6"
    />
    <g fill="none" stroke="#1a1208" stroke-linecap="round">
      <path d="M 29.1 26.7 A 9.5 9.5 0 1 0 29.1 41.3" stroke-width="7" />
      <path d="M 44 19.5 C 48 19.5 50 21.5 50 25" stroke-width="5" />
      <path d="M 44 19.5 V 46" stroke-width="7" />
      <path d="M 36.5 31 H 50.5" stroke-width="6.5" />
    </g>
  </svg>
</span>
