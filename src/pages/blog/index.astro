---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ArrowRightIcon, ClockIcon } from "@phosphor-icons/react";
import { formatDate } from "../../utils/date";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title="博客"
  description="关于 cf、编码智能体与 Cloudflare 开发体验的中文文章。"
>
  <div class="relative overflow-hidden border-b border-line">
    <div class="atmos-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative py-16 md:py-20">
      <h1
        class="text-[2.2rem] font-semibold leading-[1.12] tracking-tight text-fog-100 md:text-[3rem]"
      >
        博客
      </h1>
      <p class="mt-5 max-w-[52ch] text-[15px] leading-relaxed text-fog-500">
        关于 cf、编码智能体与 Cloudflare 开发体验的文章。
      </p>
    </div>
  </div>

  <div class="shell py-14 md:py-20">
    <ul class="grid gap-px">
      {
        posts.map((post, index) => (
          <li data-reveal style={`--reveal-step:${index}`}>
            <a
              href={`/blog/${post.id}`}
              class="group block border-b border-line py-8 transition-colors duration-200"
            >
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[11.5px] text-fog-600">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt)}
                </time>
                <span class="flex items-center gap-1.5">
                  <ClockIcon size={12} weight="bold" />
                  约 {post.data.minutes} 分钟
                </span>
              </div>
              <h2
                class="mt-4 max-w-[34ch] text-[1.35rem] font-semibold leading-snug tracking-tight text-fog-100 transition-colors group-hover:text-ember-400 md:text-[1.6rem]"
              >
                {post.data.title}
              </h2>
              <p class="mt-3 max-w-[60ch] text-[14.5px] leading-relaxed text-fog-500">
                {post.data.description}
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-[13.5px] text-ember-400">
                阅读全文
                <ArrowRightIcon
                  size={13}
                  weight="bold"
                  className="transition-transform duration-200 group-hover:translate-x-0.5"
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
