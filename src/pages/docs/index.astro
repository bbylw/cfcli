---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ArrowRightIcon } from "@phosphor-icons/react";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const groups = docs.reduce<Record<string, typeof docs>>((acc, entry) => {
  acc[entry.data.group] ??= [];
  acc[entry.data.group]!.push(entry);
  return acc;
}, {});

const featured = docs.filter((entry) => entry.data.featured);
---

<BaseLayout
  title="文档"
  description="cf 的中文文档：安装与登录、部署第一个 Worker、面向编码智能体的用法、cloudflare.config.ts 配置与从 Wrangler 迁移。"
>
  <div class="relative overflow-hidden border-b border-line">
    <div class="atmos-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="atmos-glow left-[8%] top-[-40%] h-[320px] w-[320px] bg-ember-500/10"
      aria-hidden="true">
    </div>

    <div class="shell relative py-12 md:py-14">
      <h1
        class="max-w-[16ch] text-[2.2rem] font-semibold leading-[1.12] tracking-tight text-fog-100 md:text-[2.75rem]"
      >
        文档
      </h1>
      <p class="mt-4 max-w-[54ch] text-[15px] leading-relaxed text-fog-500">
        从安装到迁移，覆盖 cf 的完整工作流。内容整理自 Cloudflare 官方 README、发布公告与开发者文档。
      </p>

      <div class="mt-9 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {
          featured.map((entry, index) => (
            <a
              href={`/docs/${entry.id}`}
              class="panel group flex flex-col p-5 transition-colors duration-200 hover:border-ink-600"
              data-reveal
              style={`--reveal-step:${index}`}
            >
              <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-ember-500">
                {entry.data.group}
              </span>
              <span class="mt-3 text-[15px] font-medium text-fog-100">{entry.data.title}</span>
              <span class="mt-2 text-[13px] leading-relaxed text-fog-500">
                {entry.data.description}
              </span>
              <span class="mt-auto flex items-center gap-1 pt-4 text-[13px] text-ember-400">
                开始阅读
                <ArrowRightIcon
                  size={13}
                  weight="bold"
                  aria-hidden
                  className="transition-transform duration-200 group-hover:translate-x-0.5"
                />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="shell py-10 md:py-12">
    {
      Object.entries(groups).map(([groupName, entries], index) => (
        <section
          class="grid gap-x-12 gap-y-4 border-b border-line py-8 last:border-b-0 md:grid-cols-[132px_minmax(0,1fr)]"
          data-reveal
          style={`--reveal-step:${index}`}
        >
          <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-fog-600 md:pt-1.5">
            {groupName}
          </h2>
          <ul class="grid">
            {entries.map((entry) => (
              <li>
                <a
                  href={`/docs/${entry.id}`}
                  class="group grid items-baseline gap-x-6 gap-y-1 border-b border-line py-3.5 transition-colors duration-200 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)_auto]"
                >
                  <span class="min-w-0 text-[14.5px] text-fog-100 transition-colors group-hover:text-ember-400">
                    {entry.data.title}
                  </span>
                  <span class="hidden text-[13px] leading-relaxed text-fog-600 sm:block">
                    {entry.data.description}
                  </span>
                  <ArrowRightIcon
                    size={14}
                    weight="bold"
                    aria-hidden
                    className="hidden shrink-0 text-fog-600 transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-ember-400 sm:block"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
