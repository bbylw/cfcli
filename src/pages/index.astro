---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalDemo from "../components/TerminalDemo.tsx";
import ConfigShowcase from "../components/ConfigShowcase.astro";
import InstallPicker from "../components/InstallPicker.astro";
import {
  MagnifyingGlassIcon,
  BracketsCurlyIcon,
  LightningIcon,
  StackIcon,
  ArrowRightIcon,
  CheckCircleIcon,
} from "@phosphor-icons/react";

const stats = [
  { value: "3,000+", label: "可操作的 API" },
  { value: "280", label: "Wrangler 原有命令" },
  { value: "48%", label: "上周智能体执行占比" },
  { value: "18 个月", label: "Wrangler 维护支持" },
];

const naming = [
  { product: "D1", command: "d1 info" },
  { product: "Hyperdrive", command: "hyperdrive get" },
  { product: "Workflows", command: "workflows describe" },
];

const cells = [
  {
    span: "md:col-span-2",
    icon: MagnifyingGlassIcon,
    title: "智能体自己找到命令",
    body: "用自然语言描述目标，cf cli search 会依据 API 描述与参数返回可用命令，不必先记住命令名。",
    visual: "search" as const,
  },
  {
    span: "",
    icon: BracketsCurlyIcon,
    title: "JSON 才是默认输出",
    body: "对人类美化排版，对智能体压缩成单行，省下的是上下文。",
    visual: "json" as const,
  },
  {
    span: "",
    icon: StackIcon,
    title: "覆盖整个 API",
    body: "从 Workers 到 DNS、WAF、Access 与域名注册，一个工具触达全部产品。",
    visual: "coverage" as const,
  },
  {
    span: "md:col-span-2",
    icon: LightningIcon,
    title: "Vite 成为默认构建",
    body: "具备 HMR 的开发服务器、基于 Rolldown 的构建，以及可直接复用的 Vite 插件生态。",
    visual: "vite" as const,
  },
];

const migration = [
  {
    step: "01",
    title: "跑一条命令",
    body: "cf migrate 读取 Wrangler 配置，生成 cloudflare.config.ts 并接管依赖。",
  },
  {
    step: "02",
    title: "处理待办",
    body: "无法自动转换的条目会列成清单，例如 Durable Object 绑定需要迁移后复核。",
  },
  {
    step: "03",
    title: "继续用 Wrangler",
    body: "esbuild 的 JavaScript Worker 与 Rust、Python Worker 仍由 Wrangler 开发部署。",
  },
];

const coverage = ["Workers", "D1", "R2", "KV", "DNS", "WAF", "Access", "Pages", "Queues", "Workflows", "Hyperdrive", "Registrar"];
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="atmos-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="atmos-glow drift-slow left-[-12%] top-[-16%] h-[420px] w-[420px] bg-ember-500/12"
      aria-hidden="true"></div>

    <div class="shell relative grid items-center gap-14 pb-16 pt-14 lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:pb-24 lg:pt-20">
      <div>
        <h1 class="headline text-[2.4rem] font-semibold leading-[1.1] tracking-tight text-fog-100 sm:text-[3rem] lg:text-[3.4rem]">
          整个 <span class="nb">Cloudflare API</span>，<br />一个 cf
        </h1>
        <p class="mt-6 max-w-[44ch] text-[15px] leading-relaxed text-fog-500 md:text-[1.02rem]">
          内置智能体命令搜索、默认 JSON 输出、TypeScript 配置与 Vite 构建，一次覆盖 3,000+ 操作。
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/docs/install" class="btn btn-primary">
            <LightningIcon size={16} weight="bold" />
            安装 cf
          </a>
          <a href="/docs" class="btn btn-ghost">
            阅读文档
            <ArrowRightIcon size={16} weight="bold" />
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:pl-2">
        <TerminalDemo client:load />
      </div>
    </div>
  </section>

  <!-- 数据带 -->
  <section class="rule section-tight" data-reveal>
    <div class="shell grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
      {
        stats.map((stat, index) => (
          <div
            class="relative lg:border-l lg:border-line lg:first:border-l-0 lg:pl-6"
            data-reveal
            style={`--reveal-step:${index}`}
          >
            <div class="font-mono text-[1.75rem] font-medium leading-none tracking-tight text-fog-100 tabular-nums md:text-[2rem]">
              {stat.value}
            </div>
            <p class="mt-2.5 text-[12.5px] leading-snug text-fog-600">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 为什么是 cf -->
  <section class="section" data-reveal>
    <div class="shell grid items-start gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <h2 class="headline max-w-[20ch] text-[1.8rem] font-semibold leading-[1.18] tracking-tight text-fog-100 md:text-[2.2rem]">
          扩展，而不是把 <span class="nb">280 条命令</span><br class="hidden sm:block" />
          推到 3,000 条
        </h2>
        <div class="mt-6 grid max-w-[54ch] gap-4 text-[15px] leading-relaxed text-fog-500">
          <p>
            Wrangler 由各产品团队手工构建，即使只有约 280 条命令路径，术语与模式也难以统一。同一件事在不同产品里有三种写法。
          </p>
          <p>
            cf 换了一条路：命令直接从支撑 API 文档与 SDK 的 OpenAPI 模式生成。产品只需为模式补充少量注解，新增能力即可自动出现在 CLI 中。
          </p>
        </div>
      </div>

      <div class="panel min-w-0 p-6 md:p-7">
        <p class="text-[13.5px] font-medium text-fog-300">同一件事，三种命名</p>
        <ul class="mt-5 grid gap-3">
          {
            naming.map((item) => (
              <li class="flex items-center justify-between gap-4 border-b border-line pb-3 last:border-0 last:pb-0">
                <span class="text-[13px] text-fog-600">{item.product}</span>
                <code class="font-mono text-[13px] text-fog-300">{item.command}</code>
              </li>
            ))
          }
        </ul>

        <div class="mt-7 flex items-start gap-3 rounded-xl border border-ember-500/25 bg-ember-500/8 p-4">
          <CheckCircleIcon size={18} weight="bold" className="mt-0.5 shrink-0 text-ember-500" />
          <p class="text-[13.5px] leading-relaxed text-fog-300">
            在 cf 中，命名与参数由同一份模式决定，命令之间不再各说各话。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 能力 bento -->
  <section class="rule section">
    <div class="shell">
      <div class="max-w-[58ch]" data-reveal>
        <h2 class="headline text-[1.8rem] font-semibold leading-[1.18] tracking-tight text-fog-100 md:text-[2.2rem]">
          为智能体构建，人类同样顺手
        </h2>
        <p class="mt-4 text-[15px] leading-relaxed text-fog-500">
          每一个设计取舍都指向同一件事：让智能体少花上下文，让你少花时间。
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          cells.map((cell, index) => (
            <article
              class:list={[
                "panel relative flex min-w-0 flex-col overflow-hidden p-6 md:p-7",
                cell.span,
              ]}
              data-reveal
              style={`--reveal-step:${index}`}
            >
              <div class="flex items-center gap-2.5">
                <cell.icon size={18} weight="bold" className="text-ember-500" />
                <h3 class="text-[15px] font-semibold tracking-tight text-fog-100">
                  {cell.title}
                </h3>
              </div>
              <p class="mt-3 max-w-[46ch] text-[13.5px] leading-relaxed text-fog-500">
                {cell.body}
              </p>

              {cell.visual === "search" && (
                <div class="mt-6 grid gap-2">
                  <div class="flex items-center gap-2 rounded-full border border-line bg-ink-850 px-3.5 py-2">
                    <MagnifyingGlassIcon size={14} weight="bold" className="text-fog-600" />
                    <span class="font-mono text-[12px] text-fog-300">
                      cf cli search "create D1 database"
                    </span>
                  </div>
                  <div class="grid gap-2 pl-1">
                    <div class="flex items-baseline gap-2">
                      <code class="font-mono text-[12px] text-ember-400">cf d1 create</code>
                      <span class="text-[12px] text-fog-600">找到命令</span>
                    </div>
                    <div class="flex items-baseline gap-2">
                      <code class="font-mono text-[12px] text-fog-300">cf schema d1 create</code>
                      <span class="text-[12px] text-fog-600">查看参数</span>
                    </div>
                    <div class="flex items-baseline gap-2">
                      <code class="font-mono text-[12px] text-fog-300">cf d1 create --dry-run</code>
                      <span class="text-[12px] text-fog-600">预演请求</span>
                    </div>
                  </div>
                </div>
              )}

              {cell.visual === "json" && (
                <div class="mt-auto pt-6">
                  <div class="overflow-hidden rounded-xl border border-line bg-ink-950/70 p-3.5">
                    <pre class="overflow-x-auto font-mono text-[11.5px] leading-relaxed text-fog-500">
<span class="text-fog-300">"name"</span>: <span class="text-ember-400">"my-worker"</span>,
<span class="text-fog-300">"routes"</span>: <span class="text-fog-100">3</span></pre>
                  </div>
                  <div class="mt-3 flex items-center justify-between gap-3 border-t border-line pt-3">
                    <span class="text-[11.5px] text-fog-600">人类可读</span>
                    <span class="font-mono text-[11.5px] text-fog-600">12 行</span>
                    <span class="h-px flex-1 bg-line"></span>
                    <span class="text-[11.5px] text-fog-600">智能体</span>
                    <span class="font-mono text-[11.5px] text-ember-400">1 行</span>
                  </div>
                </div>
              )}

              {cell.visual === "coverage" && (
                <div class="mt-auto flex flex-wrap gap-1.5 pt-6">
                  {coverage.map((item) => (
                    <span class="rounded-full border border-line bg-ink-850 px-2.5 py-1 font-mono text-[11px] text-fog-600">
                      {item}
                    </span>
                  ))}
                </div>
              )}

              {cell.visual === "vite" && (
                <div class="mt-auto flex flex-wrap gap-2 pt-6">
                  {["HMR", "Rolldown", "Vitest", "Vite 插件"].map((tag) => (
                    <span class="rounded-full border border-line bg-ink-850 px-3 py-1 font-mono text-[11.5px] text-fog-500">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 配置即代码 -->
  <section class="rule section">
    <div class="shell">
      <div class="grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
        <div data-reveal>
          <h2 class="headline max-w-[14ch] text-[1.8rem] font-semibold leading-[1.18] tracking-tight text-fog-100 md:text-[2.2rem]">
            配置也能被<br />类型检查
          </h2>
          <div class="mt-5 grid max-w-[46ch] gap-4 text-[15px] leading-relaxed text-fog-500">
            <p>
              cloudflare.config.ts 让人类与编辑器都读得懂配置。使用 LSP 的智能体可以直接在上下文中解读它，给出更准确的建议。
            </p>
            <p>
              TOML 没有可访问的模式，JSONC 虽有模式却很少被智能体使用；TypeScript 两者兼得。
            </p>
          </div>
          <a
            href="/docs/config"
            class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-ember-400 transition-colors hover:text-ember-500"
          >
            查看配置指南
            <ArrowRightIcon size={15} weight="bold" />
          </a>
        </div>

        <div class="min-w-0" data-reveal style="--reveal-step:1">
          <ConfigShowcase />
        </div>
      </div>
    </div>
  </section>

  <!-- 迁移：改为横向步骤流，与上一区块的左右分栏区分开 -->
  <section class="rule section">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <h2 class="headline max-w-[18ch] text-[1.8rem] font-semibold leading-[1.18] tracking-tight text-fog-100 md:text-[2.2rem]">
          从 Wrangler 迁移，<br />只要一条命令
        </h2>
        <a
          href="/docs/migrate"
          class="inline-flex items-center gap-2 text-sm font-medium text-ember-400 transition-colors hover:text-ember-500"
        >
          迁移指南
          <ArrowRightIcon size={15} weight="bold" />
        </a>
      </div>

      <ol class="mt-10 grid gap-px md:grid-cols-3">
        {
          migration.map((item, index) => (
            <li
              class="panel min-w-0 p-5 md:p-6"
              data-reveal
              style={`--reveal-step:${index}`}
            >
              <div class="flex items-center gap-3">
                <span class="font-mono text-[11px] text-ember-500 tabular-nums">
                  {item.step}
                </span>
                <span class="h-px flex-1 bg-line"></span>
              </div>
              <h3 class="mt-4 text-[15px] font-semibold tracking-tight text-fog-100">
                {item.title}
              </h3>
              <p class="mt-2.5 text-[13.5px] leading-relaxed text-fog-500">
                {item.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 安装：改为整宽收尾带，不再是第三个左右分栏 -->
  <section class="rule section">
    <div class="shell">
      <div class="panel overflow-hidden">
        <div class="grid gap-8 p-6 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-12 md:p-10">
          <div>
            <h2 class="headline max-w-[12ch] text-[1.7rem] font-semibold leading-[1.18] tracking-tight text-fog-100 md:text-[2rem]">
              全局安装，<br />随时运行
            </h2>
            <p class="mt-4 max-w-[42ch] text-[14.5px] leading-relaxed text-fog-500">
              cf 目前处于公开测试阶段，命令、配置与构建输出在稳定版发布前仍可能变化。
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/docs/install" class="btn btn-primary">
                安装并登录
                <ArrowRightIcon size={16} weight="bold" />
              </a>
              <a href="/docs/quickstart" class="btn btn-ghost">部署第一个 Worker</a>
            </div>
          </div>

          <div class="min-w-0" data-reveal style="--reveal-step:1">
            <InstallPicker />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
